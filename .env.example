# Root Environment Variables for SYNCTHEATER
# ==============================================================================

# Server & Runtime Configuration
PORT=8000
NODE_ENV=development

# Security & CORS
# In production, CORS_ORIGIN must specify exact trusted domain(s) (comma-separated).
# Wildcard '*' is strictly prohibited in production.
CORS_ORIGIN=http://localhost:3000

# Private Room & Invitation Limits
MAX_ROOM_CAPACITY=50
INVITATION_TOKEN_TTL_HOURS=72

# Authentication & JWT
# Note: In production, JWT_SECRET must be at least 32 characters and cannot use default dev secret.
JWT_SECRET=synctheater-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRATION=7d
REFRESH_TOKEN_SECRET=synctheater-super-secret-refresh-key-change-in-production-2026

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/synctheater?schema=public"

# Redis Cache & Real-Time Adapter (Optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# LiveKit WebRTC Voice/Video
LIVEKIT_URL=https://synctheater.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Frontend Configuration & Invitation Link Generation
# NEXT_PUBLIC_APP_URL is used to generate absolute, shareable invitation links:
# e.g. ${NEXT_PUBLIC_APP_URL}/room/ROOM_SLUG?invite=INVITATION_TOKEN
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=https://synctheater.livekit.cloud
