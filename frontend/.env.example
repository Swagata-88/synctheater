# Frontend Environment Variables
# Base URL of the deployed frontend web app (used for absolute invitation links)
# Format: ${NEXT_PUBLIC_APP_URL}/room/ROOM_SLUG?invite=INVITATION_TOKEN
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend REST API and WebSocket Gateway
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# LiveKit WebRTC Cloud Gateway
NEXT_PUBLIC_LIVEKIT_URL=https://synctheater.livekit.cloud
